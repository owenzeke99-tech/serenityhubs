-- Serenity Hub - Key System (Centered Text Box & No Overflow Fix)
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")

-- Sử dụng getgenv() để lưu trạng thái key trong suốt phiên chơi
getgenv().SerenitySavedKey = getgenv().SerenitySavedKey or false

if getgenv().SerenitySavedKey then
    loadstring(game:HttpGet("https://raw.githubusercontent.com/MUshihara/Serenity-hub/main/loader.lua"))()
    return
end

-- Xóa UI cũ nếu tồn tại
if CoreGui:FindFirstChild("SerenityKeySystem") then
    CoreGui.SerenityKeySystem:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "SerenityKeySystem"
ScreenGui.Parent = CoreGui
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

-- Main Frame
local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 360, 0, 225)
MainFrame.Position = UDim2.new(0.5, -180, 0.5, -112)
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
MainFrame.BorderSizePixel = 0
MainFrame.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 12)
UICorner.Parent = MainFrame

local UIStroke = Instance.new("UIStroke")
UIStroke.Color = Color3.fromRGB(255, 182, 193)
UIStroke.Transparency = 0.7
UIStroke.Thickness = 1.5
UIStroke.Parent = MainFrame

-- Tiêu đề chính: SERENITY HUB
local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 35)
Title.Position = UDim2.new(0, 0, 0, 8)
Title.BackgroundTransparency = 1
Title.Text = "SERENITY HUB"
Title.TextColor3 = Color3.fromRGB(255, 182, 193)
Title.TextSize = 22
Title.Font = Enum.Font.GothamBold
Title.Parent = MainFrame

-- Dòng phụ tiếng Anh
local SubTitle = Instance.new("TextLabel")
SubTitle.Size = UDim2.new(1, 0, 0, 20)
SubTitle.Position = UDim2.new(0, 0, 0, 38)
SubTitle.BackgroundTransparency = 1
SubTitle.Text = "Please Enter Your Key Below"
SubTitle.TextColor3 = Color3.fromRGB(150, 150, 160)
SubTitle.TextSize = 11
SubTitle.Font = Enum.Font.GothamMedium
SubTitle.Parent = MainFrame

-- Ô nhập Key (TextBox) - Đã căn giữa tuyệt đối và chỉnh cỡ chữ gọn gàng chống tràn
local TextBox = Instance.new("TextBox")
TextBox.Size = UDim2.new(0.85, 0, 0, 42)
TextBox.Position = UDim2.new(0.075, 0, 0, 68)
TextBox.PlaceholderText = "Enter your key here..."
TextBox.PlaceholderColor3 = Color3.fromRGB(100, 100, 110)
TextBox.Text = ""
TextBox.TextColor3 = Color3.fromRGB(255, 255, 255)
TextBox.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
TextBox.TextSize = 12 -- Giảm nhẹ cỡ chữ một chút để chứa key dài thoải mái
TextBox.Font = Enum.Font.Gotham
TextBox.ClearTextOnFocus = false
TextBox.TextXAlignment = Enum.TextXAlignment.Center -- Căn giữa ô nhập
TextBox.ClipsDescendants = true -- Ẩn hoàn phần chữ bị thừa ra ngoài khung nếu có
TextBox.Parent = MainFrame

local TextBoxCorner = Instance.new("UICorner")
TextBoxCorner.CornerRadius = UDim.new(0, 8)
TextBoxCorner.Parent = TextBox

local TextBoxStroke = Instance.new("UIStroke")
TextBoxStroke.Color = Color3.fromRGB(50, 50, 60)
TextBoxStroke.Parent = TextBox

-- Nút Kiểm Tra (Verify)
local SubmitBtn = Instance.new("TextButton")
SubmitBtn.Size = UDim2.new(0.41, 0, 0, 40)
SubmitBtn.Position = UDim2.new(0.075, 0, 0, 125)
SubmitBtn.Text = "Verify Key"
SubmitBtn.TextColor3 = Color3.fromRGB(15, 15, 18)
SubmitBtn.BackgroundColor3 = Color3.fromRGB(255, 182, 193)
SubmitBtn.TextSize = 14
SubmitBtn.Font = Enum.Font.GothamBold
SubmitBtn.Parent = MainFrame

local BtnCorner1 = Instance.new("UICorner")
BtnCorner1.CornerRadius = UDim.new(0, 8)
BtnCorner1.Parent = SubmitBtn

-- Nút Lấy Key (Get Key)
local GetKeyBtn = Instance.new("TextButton")
GetKeyBtn.Size = UDim2.new(0.41, 0, 0, 40)
GetKeyBtn.Position = UDim2.new(0.515, 0, 0, 125)
GetKeyBtn.Text = "Get Key"
GetKeyBtn.TextColor3 = Color3.fromRGB(255, 182, 193)
GetKeyBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
GetKeyBtn.TextSize = 14
GetKeyBtn.Font = Enum.Font.GothamBold
GetKeyBtn.Parent = MainFrame

local BtnCorner2 = Instance.new("UICorner")
BtnCorner2.CornerRadius = UDim.new(0, 8)
BtnCorner2.Parent = GetKeyBtn

local GetKeyStroke = Instance.new("UIStroke")
GetKeyStroke.Color = Color3.fromRGB(255, 182, 193)
GetKeyStroke.Transparency = 0.5
GetKeyStroke.Parent = GetKeyBtn

-- Trạng thái thông báo
local StatusLabel = Instance.new("TextLabel")
StatusLabel.Size = UDim2.new(1, 0, 0, 20)
StatusLabel.Position = UDim2.new(0, 0, 0, 175)
StatusLabel.BackgroundTransparency = 1
StatusLabel.Text = ""
StatusLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
StatusLabel.TextSize = 13
StatusLabel.Font = Enum.Font.GothamMedium
StatusLabel.Parent = MainFrame

-- Hiệu ứng lắc mượt mà
local function smoothShake()
    local basePos = UDim2.new(0.5, -180, 0.5, -112)
    local tweenInfo = TweenInfo.new(0.05, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
    
    local offsets = {10, -10, 7, -7, 4, -4, 0}
    for _, offset in ipairs(offsets) do
        local goal = {Position = basePos + UDim2.new(0, offset, 0, 0)}
        local tween = TweenService:Create(MainFrame, tweenInfo, goal)
        tween:Play()
        tween.Completed:Wait()
    end
end

-- Get Key Click
GetKeyBtn.MouseButton1Click:Connect(function()
    setclipboard("https://link4m.net/uI51kW6a")
    StatusLabel.TextColor3 = Color3.fromRGB(180, 255, 180)
    StatusLabel.Text = "Key link copied to clipboard!"
end)

-- Verify Key Click
SubmitBtn.MouseButton1Click:Connect(function()
    local enteredKey = TextBox.Text
    local correctKey = "SerenityHubKeyHsiwjAlwieheooehVsiwoenslbdoHsowpaljs"
    
    if enteredKey == correctKey then
        StatusLabel.TextColor3 = Color3.fromRGB(180, 255, 180)
        StatusLabel.Text = "Correct Key! Loading hub..."
        
        getgenv().SerenitySavedKey = true
        
        task.wait(0.8)
        ScreenGui:Destroy()
        
        loadstring(game:HttpGet("https://raw.githubusercontent.com/MUshihara/Serenity-hub/main/loader.lua"))()
    else
        StatusLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
        StatusLabel.Text = "Incorrect key! Please try again."
        TextBox.Text = ""
        task.spawn(smoothShake)
    end
end)
